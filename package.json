{
  "name": "jt-proxense",
  "version": "0.9.9",
  "description": "Proxmox VE Monitoring System with Sci-Fi UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && mkdir -p dist/assets/xterm && cp node_modules/xterm/lib/xterm.js node_modules/xterm/css/xterm.css node_modules/xterm-addon-fit/lib/xterm-addon-fit.js dist/assets/xterm/",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "rebuild": "bash scripts/rebuild.sh",
    "restart-all": "bash scripts/restart-all.sh"
  },
  "dependencies": {
    "@novnc/novnc": "^1.4.0",
    "d3": "^7.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "xterm": "^5.3.0",
    "xterm-addon-attach": "^0.9.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  }
}
